# CINEVERSE Frontend Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.

# ─── Backend API ─────────────────────────────────────────────────────────────
# The URL of the FastAPI backend server
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# ─── Supabase (Public keys — safe to expose in browser) ───────────────────────
# These are the ANON (public) keys — not secret. Only the SERVICE key is secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── Content & Streaming Metadata ────────────────────────────────────────────
# Watchmode API credentials are strictly server-side in backend/.env.
# Never put API secrets (WATCHMODE_API_KEY, LLM_API_KEY, SUPABASE_SERVICE_KEY)
# in NEXT_PUBLIC_ variables, as those are exposed to the browser.

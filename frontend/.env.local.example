# CINEVERSE Frontend Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.

# ─── Backend API ─────────────────────────────────────────────────────────────
# The URL of the FastAPI backend server
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# ─── Supabase (Public keys — safe to expose in browser) ───────────────────────
# These are the ANON (public) keys — not secret. Only the SERVICE key is secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── TMDB ─────────────────────────────────────────────────────────────────────
# If you need TMDB access from the browser (not recommended — use backend instead)
# NEXT_PUBLIC_TMDB_API_KEY=

# NOTE: Never put secret keys (LLM_API_KEY, SUPABASE_SERVICE_KEY, etc.)
# in NEXT_PUBLIC_ variables. Those are exposed to the browser.

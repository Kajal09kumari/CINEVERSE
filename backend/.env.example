# CINEVERSE Backend Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to version control.

# ─── FastAPI Settings ───────────────────────────────────────────────────────
DEBUG=true
FRONTEND_ORIGIN=http://localhost:3000

# ─── Watchmode API ──────────────────────────────────────────────────────────
# Get your API key at: https://api.watchmode.com/
WATCHMODE_API_KEY=your_watchmode_api_key
WATCHMODE_BASE_URL=https://api.watchmode.com/v1
WATCHMODE_REGION=IN
CINEVERSE_CACHE_ENABLED=true

# ─── MovieLens & Local Database ─────────────────────────────────────────────
MOVIELENS_DATA_DIR=./ml/data/raw
DATABASE_URL=sqlite:///./data/cineverse.db

# ─── LLM API (Optional for MIRA conversational mode) ────────────────────────
# Used by MIRA (Movie Intelligence & Recommendation Assistant)
LLM_API_KEY=your_llm_api_key_here

# ─── Supabase (Optional cloud sync) ─────────────────────────────────────────
# Get these from your Supabase project dashboard
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
